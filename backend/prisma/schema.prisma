// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  seller
  buyer
  driver
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  email        String     @unique
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  roles        UserRole[]
  stores       Store[]
  wallet       Wallet?
  addresses    Address[]
  cart         Cart?
  buyerOrders  Order[]    @relation("BuyerOrders")
  driverOrders Order[]    @relation("DriverOrders")
  reviews      ProductReview[]
  refreshTokens RefreshToken[] @relation("UserRefreshTokens")

  @@map("users")
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  role   Role
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model AppReview {
  id           Int      @id @default(autoincrement())
  reviewerName String   @map("reviewer_name")
  rating       Int
  comment      String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("app_reviews")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Store {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  sellerId    Int       @unique
  seller      User      @relation(fields: [sellerId], references: [id])
  products    Product[]
  coupons     Coupon[]
  carts       Cart[]
  storeOrders Order[]   
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("stores")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  stock       Int         @default(0)
  storeId     Int
  store       Store       @relation(fields: [storeId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     ProductReview[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("products")
}

enum CouponCategory {
  voucher
  promo
}

enum CouponType {
  percent
  nominal
}

model Coupon {
  id          Int             @id @default(autoincrement())
  storeId     Int?
  store       Store?          @relation(fields: [storeId], references: [id])
  code        String          @unique
  category    CouponCategory  @default(voucher)
  type        CouponType
  value       Decimal   @db.Decimal(12, 2)
  minPurchase Decimal?  @db.Decimal(12, 2) @map("min_purchase")
  maxUsage    Int       @default(0)
  usageCount  Int       @default(0) @map("usage_count")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  orders      Order[]

  @@map("coupons")
}

model ProductReview {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  buyerId   Int
  buyer     User     @relation(fields: [buyerId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, buyerId])
  @@map("product_reviews")
}

enum WalletTransactionType {
  topup
  payment
  refund
}

enum DeliveryMethod {
  instant
  next_day
  regular
}

enum OrderStatus {
  sedang_dikemas
  menunggu_pengirim
  sedang_dikirim
  pesanan_selesai
  dikembalikan
}

model Wallet {
  id           Int      @id @default(autoincrement())
  buyerId      Int      @unique
  buyer        User     @relation(fields: [buyerId], references: [id])
  balance      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          Int                   @id @default(autoincrement())
  walletId    Int
  wallet      Wallet                @relation(fields: [walletId], references: [id])
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(12, 2)
  description String
  createdAt   DateTime              @default(now()) @map("created_at")

  @@map("wallet_transactions")
}

model Address {
  id           Int      @id @default(autoincrement())
  buyerId      Int
  buyer        User     @relation(fields: [buyerId], references: [id])
  label        String
  recipientName String  @map("recipient_name")
  phone        String
  street       String
  city         String
  province     String
  postalCode   String   @map("postal_code")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  orders       Order[]

  @@map("addresses")
}

model Cart {
  id        Int        @id @default(autoincrement())
  buyerId   Int        @unique
  buyer     User       @relation(fields: [buyerId], references: [id])
  storeId   Int?
  store     Store?     @relation(fields: [storeId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id             Int              @id @default(autoincrement())
  buyerId        Int
  buyer          User             @relation("BuyerOrders", fields: [buyerId], references: [id])
  storeId        Int
  store          Store            @relation(fields: [storeId], references: [id])
  addressId      Int
  address        Address          @relation(fields: [addressId], references: [id])
  driverId       Int?
  driver         User?            @relation("DriverOrders", fields: [driverId], references: [id])
  deliveryMethod DeliveryMethod   @map("delivery_method")
  deliveryFee    Decimal          @db.Decimal(12, 2) @map("delivery_fee")
  subtotal       Decimal          @db.Decimal(12, 2)
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  ppn            Decimal          @db.Decimal(12, 2)
  total          Decimal          @db.Decimal(12, 2)
  couponId       Int?
  coupon         Coupon?          @relation(fields: [couponId], references: [id])
  status         OrderStatus      @default(sedang_dikemas)
  deliveryDeadline DateTime?       @map("delivery_deadline")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]

  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)

  @@map("order_items")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("order_status_histories")
}